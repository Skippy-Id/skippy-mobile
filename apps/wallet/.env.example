# Which brand to build. Must match a folder in brands/ (see brands/README.md).
# Read by app.config.js (Node) and inlined into the bundle (brands/current.ts).
# Changing it requires a Metro cache reset: `expo start -c`.
EXPO_PUBLIC_APP_BRAND=skippy

# Skippy hub the wallet talks to. Defaults to https://app.skippy.id when unset.
# Local development: iOS simulator can use http://localhost:<port>; the Android
# emulator reaches the host at http://10.0.2.2:<port>.
EXPO_PUBLIC_SKIPPY_HUB_URL=

# Expo/EAS account details, used in place of the __SKIPPY_TODO_* placeholders in
# brands/<brand>/config.js. See docs/STORE_RELEASE.md.
EXPO_OWNER=
EAS_PROJECT_ID=

# Only needed when a brand enables CLOUD_HSM (Skippy does not).
EXPO_PUBLIC_WALLET_SERVICE_PROVIDER_URL=
